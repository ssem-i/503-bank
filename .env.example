# bank(모의 은행) 환경변수. 이 파일을 .env로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 값을 비워 두면 괄호 안 기본값을 쓴다. "필수"는 비우면 기동하지 않는다.

# --- 인증 키 (replant 앱 서버 ~/secrets/payment.env의 BANK_API_KEY와 같은 값) ---
# 필수. payment -> bank 호출 시 X-Api-Key. 값은 로그·커밋 금지
BANK_API_KEY=

# --- 서버 ---
# 포트 (3001). 운영 compose는 3001로 고정한다
PORT=
# SQLite 파일 경로 (./data/bank.db). 운영 compose는 /data/bank.db(bank-data 볼륨)로 고정한다
DB_PATH=

# --- 장애 주입 (README "장애 주입" 표 참고) ---
# none | error | slow (none). error: 기록 없이 500, slow: 기록 없이 FAULT_DELAY_MS 뒤 503
FAULT_MODE=
# slow 모드와 끝자리 9999 계좌의 응답 지연 ms (10000)
FAULT_DELAY_MS=
